# PAYGUARD Environment Configuration Example
# Copy to .env for local overrides

# Application
ENVIRONMENT=development
DEBUG=true
APP_NAME=PAYGUARD
APP_VERSION=0.1.0

# Server
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Security Policies Default Settings
DEFAULT_MAX_TX_AMOUNT=50.0
DEFAULT_DAILY_LIMIT=200.0
DEFAULT_HIGH_RISK_THRESHOLD=70
DEFAULT_MEDIUM_RISK_THRESHOLD=30

# Blockchain (Future Phase - Near Testnet)
NEAR_NETWORK=testnet
NEAR_NODE_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_ID=payguard-vault.testnet
