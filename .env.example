# ==============================================================================
# PAYGUARD — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development, or configure these variables
# directly in your production secrets manager / Docker environment.
#
# SECURITY NOTICE:
# - NEVER commit real .env files containing private keys, mnemonics, or API tokens.
# - Keep all Ed25519 signing keys and provider credentials strictly server-side.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Enable debug mode (set to false in production to disable verbose tracebacks)
DEBUG=true

# Application Metadata
APP_NAME=PAYGUARD
APP_VERSION=0.3.0

# ------------------------------------------------------------------------------
# 2. SERVER & NETWORKING CONFIGURATION
# ------------------------------------------------------------------------------
# Bind host (0.0.0.0 for Docker containers, 127.0.0.1 for local standalone)
HOST=127.0.0.1
PORT=8000

# CORS Whitelist (JSON array or comma-separated string)
# In production, restrict this strictly to your production domain(s)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 3. DATABASE PERSISTENCE (SQLite WAL)
# ------------------------------------------------------------------------------
# Filepath for persistent SQLite storage.
# In Docker: use a volume-backed path such as /app/data/payguard.db
DATABASE_PATH=backend/payguard.db

# ------------------------------------------------------------------------------
# 4. LLM GATEWAY (MULTI-PROVIDER AI INTELLIGENCE)
# ------------------------------------------------------------------------------
# Supported providers: 'mock', 'openai', 'anthropic', 'gemini', 'groq', 'ollama'
LLM_PROVIDER=mock

# Target LLM Model identifier
LLM_MODEL=gpt-4o-mini

# API Key for chosen LLM provider (Leave empty when using 'mock' or local 'ollama')
LLM_API_KEY=

# Custom API base URL (Optional; useful for enterprise gateways or Ollama endpoints)
# Example for Ollama: http://localhost:11434/v1
LLM_API_BASE=

# Network timeout for LLM inferences (seconds)
LLM_TIMEOUT_SECONDS=10.0

# Temperature for deterministic evaluation
LLM_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# 5. MULTI-AGENT ORCHESTRATION SUBSYSTEM
# ------------------------------------------------------------------------------
# Master switch for LangGraph multi-agent advisory intelligence
ENABLE_MULTI_AGENT=true

# Individual specialized agent switches
INTENT_AGENT_ENABLED=true
BEHAVIOURAL_AGENT_ENABLED=true
SECURITY_INTEL_AGENT_ENABLED=true
AUDIT_AGENT_ENABLED=true

# ------------------------------------------------------------------------------
# 6. DETERMINISTIC SECURITY POLICY DEFAULTS
# ------------------------------------------------------------------------------
# Maximum permitted transaction amount in NEAR before hard BLOCK
DEFAULT_MAX_TX_AMOUNT=50.0

# Rolling 24-hour spending limit in NEAR
DEFAULT_DAILY_LIMIT=200.0

# Risk threshold scores (0-100)
DEFAULT_HIGH_RISK_THRESHOLD=70
DEFAULT_MEDIUM_RISK_THRESHOLD=30

# Deduplication sliding window (seconds) to prevent double-spend replay attacks
DUPLICATE_WINDOW_SECONDS=120

# ------------------------------------------------------------------------------
# 7. NEAR BLOCKCHAIN & SMART CONTRACT CONFIGURATION
# ------------------------------------------------------------------------------
# Network ID ('testnet' or 'mainnet' - DO NOT use mainnet in hackathon testing)
NEAR_NETWORK=testnet

# Public NEAR JSON-RPC Node endpoint
NEAR_NODE_URL=https://rpc.testnet.near.org

# Target Smart Contract Vault account ID on NEAR Testnet
NEAR_CONTRACT_ID=payguard-vault.testnet

# Authorized Signer Account (Optional override; fallback generates ephemeral Ed25519 pair)
# NEAR_SIGNER_ACCOUNT_ID=payguard-authority.testnet
# NEAR_SIGNER_PRIVATE_KEY=ed25519:...

# ------------------------------------------------------------------------------
# 8. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Vite)
# ------------------------------------------------------------------------------
# Note: Vite environment variables must be prefixed with VITE_ to be exposed to the browser.
# DO NOT place private keys or secrets in these variables.
VITE_API_URL=http://127.0.0.1:8000/api
VITE_WS_URL=ws://127.0.0.1:8000/ws/events
